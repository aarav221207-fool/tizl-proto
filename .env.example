# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# App Configuration
NEXT_PUBLIC_APP_URL=https://tizl.in
NODE_ENV=production

# Paytm Payment Gateway & UPI Configuration
PAYTM_MID=your_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=DEFAULT
PAYTM_ENVIRONMENT=staging
PAYTM_CALLBACK_URL=https://tizl.in/api/payments/callback

# DigiLocker / Aadhaar KYC Configuration (Server-Only)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
# Admin Security
ADMIN_BOOTSTRAP_SECRET=your_super_secret_bootstrap_key
