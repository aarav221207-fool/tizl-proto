# ==============================================================================
# Tizl Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Netlify, Vercel), set these in the dashboard Environment Variables.
# NEVER commit .env.local or production secrets to Git.

# ------------------------------------------------------------------------------
# 1. APPLICATION URL & CORE SETTINGS
# ------------------------------------------------------------------------------
# Base URL of the deployment (public, client & server)
# In production on Netlify: https://your-site-name.netlify.app or https://tizl.in
NEXT_PUBLIC_APP_URL=https://tizl.in

# ------------------------------------------------------------------------------
# 2. SUPABASE (Required for Live Database, Auth & Realtime)
# ------------------------------------------------------------------------------
# Find these in your Supabase project: Settings -> API
# Public Project URL (safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Anonymous API Key (safe for client-side bundle, subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Service Role Key (CONFIDENTIAL - NEVER prefix with NEXT_PUBLIC_)
# Used strictly in API routes and server context to bypass RLS for administrative tasks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. ADMIN BOOTSTRAP & SECURITY (Server-Side Only)
# ------------------------------------------------------------------------------
# Secret token used by /api/admin/bootstrap to provision the initial superadmin account
ADMIN_BOOTSTRAP_SECRET=your-secure-admin-bootstrap-secret

# ------------------------------------------------------------------------------
# 4. PAYTM PAYMENT GATEWAY (Optional - server-side payment processing)
# ------------------------------------------------------------------------------
# Paytm Merchant Identifier
PAYTM_MID=your-paytm-merchant-id

# Paytm Merchant Secret Key (CONFIDENTIAL)
PAYTM_MERCHANT_KEY=your-paytm-merchant-key

# Paytm Website name (e.g. WEBSTAGING for staging/test, DEFAULT for production)
PAYTM_WEBSITE=WEBSTAGING

# Paytm Environment: 'staging' or 'production'
PAYTM_ENVIRONMENT=staging

# Paytm Callback URL (must point to your live URL or webhook endpoint)
PAYTM_CALLBACK_URL=https://tizl.in/api/payments/callback

# ------------------------------------------------------------------------------
# 5. DIGILOCKER IDENTITY VERIFICATION (Optional - cook/partner KYC)
# ------------------------------------------------------------------------------
DIGILOCKER_CLIENT_ID=your-digilocker-client-id
DIGILOCKER_CLIENT_SECRET=your-digilocker-client-secret

# ------------------------------------------------------------------------------
# 6. OPTIONAL SERVICES
# ------------------------------------------------------------------------------
# Gemini API Key (if AI assistance features are enabled)
GEMINI_API_KEY=